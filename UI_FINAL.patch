+const names = ["Aster pulse rifle", "Meridian field suit", "Parallax nav module", "Emergency medkit", "Helix coil carbine", "Vanguard shield core", "Deep-space beacon", "Oxygen reserve"];
+const rarities = ["STANDARD", "RARE", "EXOTIC", "RARE"];
