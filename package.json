{
  "name": "yage",
  "version": "0.0.7",
  "type": "module",
  "license": "LicenseRef-LICENSE.txt",
  "exports": {
    ".": {
      "yage-source": "./engine/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./vite": {
      "types": "./tooling/vite.d.ts",
      "import": "./tooling/vite.mjs",
      "default": "./tooling/vite.mjs"
    },
    "./tsconfig": "./tsconfig.source.json",
    "./style.css": {
      "yage-source": "./engine/style.css",
      "default": "./dist/style.css"
    },
    "./components": {
      "yage-source": "./engine/systems/index.ts",
      "types": "./dist/systems/index.d.ts",
      "import": "./dist/systems/index.js",
      "default": "./dist/systems/index.js"
    },
    "./systems": {
      "yage-source": "./engine/systems/index.ts",
      "types": "./dist/systems/index.d.ts",
      "import": "./dist/systems/index.js",
      "default": "./dist/systems/index.js"
    },
    "./schemas": {
      "yage-source": "./engine/schemas/index.ts",
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js",
      "default": "./dist/schemas/index.js"
    },
    "./constants": {
      "yage-source": "./engine/constants/index.ts",
      "types": "./dist/constants/index.d.ts",
      "import": "./dist/constants/index.js",
      "default": "./dist/constants/index.js"
    },
    "./constants/": {
      "yage-source": "./engine/constants/index.ts",
      "types": "./dist/constants/index.d.ts",
      "import": "./dist/constants/index.js",
      "default": "./dist/constants/index.js"
    },
    "./constants/*": {
      "yage-source": "./engine/constants/*.ts",
      "types": "./dist/constants/*.d.ts",
      "import": "./dist/constants/*.js",
      "default": "./dist/constants/*.js"
    },
    "./testing": {
      "yage-source": "./engine/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./vendor/noise": {
      "yage-source": "./engine/vendor/noise/index.js",
      "types": "./dist/vendor/noise/index.d.ts",
      "import": "./dist/vendor/noise/index.js",
      "default": "./dist/vendor/noise/index.js"
    },
    "./vendor/noise/index": {
      "yage-source": "./engine/vendor/noise/index.js",
      "types": "./dist/vendor/noise/index.d.ts",
      "import": "./dist/vendor/noise/index.js",
      "default": "./dist/vendor/noise/index.js"
    },
    "./*": {
      "yage-source": "./engine/*.ts",
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./tsconfig.source.json": "./tsconfig.source.json",
    "./ui/layout": {
      "yage-source": "./engine/ui/layout/index.ts",
      "types": "./dist/ui/layout/index.d.ts",
      "import": "./dist/ui/layout/index.js",
      "default": "./dist/ui/layout/index.js"
    },
    "./systems/camera": {
      "yage-source": "./engine/systems/camera/index.ts",
      "types": "./dist/systems/camera/index.d.ts",
      "import": "./dist/systems/camera/index.js",
      "default": "./dist/systems/camera/index.js"
    },
    "./ui/final": {
      "yage-source": "./engine/ui/final/index.ts",
      "types": "./dist/ui/final/index.d.ts",
      "import": "./dist/ui/final/index.js",
      "default": "./dist/ui/final/index.js"
    },
    "./audio": {
      "yage-source": "./engine/audio/index.ts",
      "types": "./dist/audio/index.d.ts",
      "import": "./dist/audio/index.js",
      "default": "./dist/audio/index.js"
    }
  },
  "scripts": {
    "dev": "vite --config examples/vite.config.js",
    "lint": "eslint --ext .ts ./engine examples/*/systems",
    "watch": "node scripts/watch.mjs",
    "tsc": "npm run typecheck",
    "test": "vitest",
    "test:e2e": "vitest --config vitest.e2e.config.ts",
    "examples": "vite --config examples/vite.config.js --host",
    "build": "vite build && npm run build:types && npm run check:package",
    "preview": "vite preview",
    "pretty": "prettier --write \"./**/*.{js,jsx,json,ts}\"",
    "server": "npx tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test:audio && npm test -- --run && npm run test:tooling && npm run test:hot-reload && npm run test:ui-final && npm run test:save-api && npm run test:persist-durability && npm run test:peer-join && npm run test:save:local && npm run build",
    "build:types": "tsc -p tsconfig.build.json",
    "build:watch": "node scripts/watch.mjs",
    "check:package": "node scripts/check-package.mjs",
    "test:tooling": "node --experimental-vm-modules --test test/tooling/*.test.mjs",
    "test:hot-reload": "node scripts/test-hot-reload-coverage.mjs",
    "test:hot-reload:browser": "YAGE_BROWSER_HMR=1 node test/tooling/hot-reload.browser.test.mjs",
    "prepack": "npm run build",
    "build:ui-final": "node scripts/build-ui-final.mjs",
    "test:ui-final": "node scripts/test-ui-final.mjs",
    "test:ui-final:browser": "node scripts/test-ui-final-browser.mjs",
    "demo:ui-final:offline": "node scripts/build-ui-final-demo.mjs",
    "demo:ui-final:airport": "node scripts/build-ui-final-airport-demo.mjs",
    "test:ui-final:html": "node scripts/test-ui-final-html-browser.mjs",
    "test:ui-final:flap-render": "node scripts/test-ui-final-flap-render.mjs",
    "server:saves": "node server/saves/run.mjs",
    "server:saves:local": "node server/local-save/process.mjs",
    "server:saves:admin": "node server/local-save/admin.mjs",
    "test:save:local": "node --test --experimental-test-coverage --test-coverage-include=server/local-save/*.mjs --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 test/local-save/*.node.mjs",
    "server:saves:backup": "node server/saves/backup.mjs backup",
    "server:saves:restore": "node server/saves/backup.mjs restore",
    "test:save-api": "node --test --experimental-test-coverage --test-coverage-include=server/saves/*.mjs --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 test/save-api/*.node.mjs",
    "test:peer-join": "node scripts/test-peer-join.mjs",
    "test:persist-durability": "node scripts/test-persist-durability.mjs",
    "test:audio": "node scripts/test-audio.mjs"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/lodash": "^4.17.0",
    "@types/ndarray": "^1.0.11",
    "@types/node": "^22.10.5",
    "@types/seedrandom": "^3.0.2",
    "@types/toastify-js": "^1.12.3",
    "@types/toposort": "^2.0.3",
    "@typescript-eslint/eslint-plugin": "^5.55.0",
    "@typescript-eslint/parser": "^5.55.0",
    "eslint": "^8.36.0",
    "eslint-plugin-unused-imports": "^2.0.0",
    "express": "^4.21.2",
    "jsdom": "^29.0.0",
    "nodemon": "^3.0.2",
    "playwright-core": "^1.52.0",
    "prettier": "^2.8.0",
    "socket.io": "^4.8.1",
    "typescript": "^5.7.2",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.2.2",
    "vitest": "^4.0.18",
    "minecs": "0.0.24",
    "pixi.js": "7.4.2"
  },
  "dependencies": {
    "@dimforge/rapier2d-deterministic-compat": "^0.19.3",
    "@json-editor/json-editor": "^2.9.0-beta.0",
    "@pixi/sound": "^5.2.3",
    "ajv": "^8.12.0",
    "deep-object-diff": "^1.1.9",
    "js-base64": "^3.7.7",
    "l1-path-finder": "^1.0.0",
    "lodash": "^4.17.21",
    "nanoid": "^5.0.2",
    "ndarray": "^1.0.19",
    "peerjs": "^1.5.1",
    "pixi-spine": "^4.0.4",
    "pixi-viewport": "5.0.2",
    "poly-decomp": "^0.3.0",
    "seedrandom": "^3.0.5",
    "socket.io-client": "^4.8.1",
    "toastify-js": "^1.12.0",
    "toposort": "^2.0.2",
    "url": "^0.11.0",
    "json5": "^2.2.3",
    "@rollup/pluginutils": "^5.1.0"
  },
  "description": "YAGE game engine with source-first Vite development and compiled package exports.",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "engine/",
    "assets/",
    "tooling/",
    "tsconfig.json",
    "tsconfig.source.json",
    "docs/",
    "LICENSE.txt",
    "README.md"
  ],
  "sideEffects": true,
  "peerDependencies": {
    "minecs": "0.0.24",
    "pixi.js": "7.4.2",
    "vite": "^7.3.1",
    "playwright-core": "^1.52.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    }
  }
}
