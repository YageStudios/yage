+class Cell {
+    readonly element: HTMLDivElement;
+    private top: Half;
+    private bottom: Half;
+    private falling: Half;
+    private landing: Half;
+    current = " ";
+    target = " ";
+    private to = " ";
+    private elapsed = -1;
+    private duration = 80;
+    private delay = 0;
+    constructor(document: Document, private clock: FlapClock, private order: string[]) {
