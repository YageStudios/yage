+import { defineHTMLComponent, type HTMLComponentContext, type Dispose } from "../../engine/ui/final/index";
+export interface AirportFlight {
+    readonly id: string;
+    readonly flight: string;
+    readonly destination: string;
+    readonly gate: string;
