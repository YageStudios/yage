+const bounce = (t: number) => {
+    const n = 7.5625, d = 2.75;
+    if (t < 1 / d)
+        return n * t * t;
+    if (t < 2 / d)
+        return n * (t -= 1.5 / d) * t + .75;
+    if (t < 2.5 / d)
+        return n * (t -= 2.25 / d) * t + .9375;
+    return n * (t -= 2.625 / d) * t + .984375;
+};
+interface Half {
+    element: HTMLDivElement;
+    glyph: HTMLSpanElement;
+    shade: HTMLDivElement;
